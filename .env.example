# Backend
APP_ENV=local
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# GitHub
GITHUB_TOKEN=
GITHUB_PERSONAL_ACCESS_TOKEN=
GITHUB_WEBHOOK_SECRET=local-dev-secret
GITHUB_REPO_URL=

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro
GEMINI_API_VERSION=v1beta
GEMINI_CLASSIFIER_MODEL=gemini-2.5-flash-lite
GEMINI_CLASSIFIER_FALLBACK_MODEL=gemini-2.5-flash
GEMINI_API_SPEC_MODEL=gemini-2.5-flash-lite
GEMINI_API_SPEC_FALLBACK_MODEL=gemini-2.5-flash

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Notion
NOTION_API_KEY=
NOTION_WORKSPACE_ID=
NOTION_DATABASE_ID=

# SendGrid
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_RECIPIENT_EMAILS=

# RAG / ChromaDB
CHROMA_PERSIST_DIRECTORY=./data/chroma
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Frontend
VITE_BACKEND_URL=http://localhost:8000
